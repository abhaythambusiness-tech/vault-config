  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-web",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-secretos",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/recordar-diseno",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/slop-gate",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|mcp__supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-destructive",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-secretos",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-proyecto",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-ui-commit",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/guard-read-grande",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/format-web",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/log-skill",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/log-mcp",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/verificar-cierre",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/check-hooks --sesion",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/recordar-errores",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "respondToBashCommands": false,
